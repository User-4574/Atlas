{
	# REQUIRED when using on_demand
	# Disable safety checks — you are explicitly allowing any name
	on_demand_tls {
		ask off
	}
}

:443 {
	# Use internal CA (snakeoil)
	tls internal {
		on_demand
	}

	# Serve CA for download (optional but recommended)
	handle /caddy-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Disposition "attachment; filename=caddy-local-root.crt"
		file_server
	}

	# Everything goes to Django
	handle {
		reverse_proxy atlas:8000
	}
}
