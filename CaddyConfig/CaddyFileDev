{
	servers {
		protocols h1 h2
	}
}

:80 {
	redir https://{host}{uri}
}

localhost:{$CaddyHTTPSPort}, 127.0.0.1:{$CaddyHTTPSPort}, {$SiteName}:{$CaddyHTTPSPort} {
	tls internal
	reverse_proxy {$AtlasServer}:{$AtlasPortInt}
}

#This redirects anything else to the sitename
:{$CaddyHTTPSPort} {
	tls internal
	redir https://{$SiteName}:{$CaddyHTTPSPort}{uri} 308
}